'Reads the PUID (Text15). Project raises an error when the field's formula
'evaluates to #ERROR; in that case "#ERROR" is returned and the run continues.
Private Function PUID(t As Task) As String
    Dim s As String
    On Error Resume Next
    s = t.Text15
    If Err.Number <> 0 Then
        Err.Clear
        s = "#ERROR"
        nPuidErr = nPuidErr + 1
    End If
    On Error GoTo 0
    PUID = s
End Function

'Reads the LOE field; a field that cannot be read is treated as "not LOE"
Private Function LoeText(t As Task) As String
    Dim s As String
    On Error Resume Next
    s = t.GetField(loeFld)
    If Err.Number <> 0 Then
        Err.Clear
        s = ""
    End If
    On Error GoTo 0
    LoeText = s
End Function

'Describes the task being read when the run stops (used by the error message)
Private Function TaskLabel(t As Task) As String
    Dim s As String
    On Error Resume Next
    If t Is Nothing Then Exit Function
    s = vbCrLf & "Task ID " & t.ID & ", Unique ID " & t.UniqueID & ": " & t.Name
    TaskLabel = s
End Function

'Adds a task row to a collector; task fields are read only once per flagged task
Private Sub AddTask(c As Collection, t As Task, row As Variant, built As Boolean, _
                    ByVal finding As String, ByVal mpd As Double)
    If Not built Then
        row = TaskRow(t, mpd)
        built = True
    End If
    row(6) = finding
    c.Add row
End Sub

Private Function TaskRow(t As Task, ByVal mpd As Double) As Variant
    Dim r(1 To TC) As Variant
    r(1) = PUID(t)                        'PUID (Text15)
    r(2) = t.Project
    r(3) = t.UniqueID
    r(4) = t.ID
    r(5) = t.Name
    r(7) = t.PercentComplete
    r(8) = NzNum(t.Duration) / mpd
    r(9) = NzNum(t.BaselineDuration) / mpd
    r(10) = DateOrEmpty(t.Start)
    r(11) = DateOrEmpty(t.Finish)
    r(12) = DateOrEmpty(t.BaselineStart)
    r(13) = DateOrEmpty(t.BaselineFinish)
    r(14) = DateOrEmpty(t.ActualStart)
    r(15) = DateOrEmpty(t.ActualFinish)
    r(16) = NzNum(t.TotalSlack) / mpd
    r(17) = ConstraintName(t.ConstraintType)
    r(18) = DateOrEmpty(t.ConstraintDate)
    TaskRow = r
End Function

Private Function RelRow(t As Task, dep As TaskDependency, ByVal mpd As Double, _
                        ByVal finding As String) As Variant
    Dim r(1 To RC) As Variant, p As Task, q As Task, lg As Double
    Set p = dep.From
    r(1) = PUID(t)                        'successor PUID
    r(2) = t.Project
    r(3) = t.UniqueID
    r(4) = t.Name
    If p.ExternalTask Then                'cross-project link: swap the ghost for the real task
        Set q = RealTask(dep, p.Name)
        If q Is Nothing Then
            r(6) = "External link - source task not resolved"
        Else
            Set p = q
        End If
    End If
    r(5) = PUID(p)                        'predecessor PUID
    If IsEmpty(r(6)) Then r(6) = p.Project
    r(7) = p.UniqueID
    r(8) = p.Name
    Select Case dep.Type
        Case pjFinishToStart:  r(9) = "FS"
        Case pjStartToStart:   r(9) = "SS"
        Case pjFinishToFinish: r(9) = "FF"
        Case pjStartToFinish:  r(9) = "SF"
    End Select
    lg = NzNum(dep.Lag)
    If lg = 0 Then
        r(10) = 0
    Else
        Select Case dep.LagType
            Case 19, 20, 51, 52                          'percent lags (Project has no named constant)
                r(10) = lg: r(11) = "% (raw value)"
            Case 4, 6, 8, 10, 12, 36, 38, 40, 42, 44     'elapsed min/hr/day/wk/mon, incl. estimated
                r(10) = lg / 1440: r(11) = "elapsed days"
            Case Else
                r(10) = lg / mpd: r(11) = "working days"
        End Select
    End If
    r(12) = finding
    RelRow = r
End Function

'Finds the real task behind a ghost task using the link's external path ("...\File.mpp\ID").
'Returns Nothing if the file is not part of this master or the name does not match.
Private Function RealTask(dep As TaskDependency, ByVal ghostName As String) As Task
    Dim pth As String, k As Long, fileKey As String, id As Long
    Dim src As Project, q As Task
    On Error Resume Next
    pth = dep.Path
    k = InStrRev(pth, "\")
    If k = 0 Then Exit Function
    If Not IsNumeric(Mid$(pth, k + 1)) Then Exit Function
    id = CLng(Mid$(pth, k + 1))
    fileKey = Left$(pth, k - 1)
    If dFiles.Exists(fileKey) Then
        Set src = dFiles(fileKey)
    ElseIf dFiles.Exists(BaseName(fileKey)) Then
        Set src = dFiles(BaseName(fileKey))
    End If
    If src Is Nothing Then Exit Function
    Set q = src.Tasks(id)
    If q Is Nothing Then Exit Function
    If StrComp(q.Name, ghostName, vbTextCompare) = 0 Then Set RealTask = q
End Function

'Writes one collector to a new sheet with a single Range.Value assignment, then formats it
Private Sub DumpSheet(wb As Object, ByVal nm As String, hdr As Variant, c As Collection, _
                      ByVal isRel As Boolean)
    Dim ws As Object, a() As Variant, r As Variant, k As Variant
    Dim i As Long, j As Long, n As Long, nc As Long

    Set ws = wb.Worksheets.Add(, wb.Worksheets(wb.Worksheets.Count))
    ws.Name = nm
    nc = UBound(hdr) - LBound(hdr) + 1
    n = c.Count

    'Text format keeps PUIDs intact (leading zeros) and stops names starting with "=" or "-" becoming formulas
    If isRel Then
        For Each k In Array(1, 4, 5, 8): ws.Columns(k).NumberFormat = "@": Next k
        ws.Columns(10).NumberFormat = "0.0;[Red]-0.0"
    Else
        For Each k In Array(1, 5): ws.Columns(k).NumberFormat = "@": Next k
        For Each k In Array(8, 9): ws.Columns(k).NumberFormat = "0.0": Next k
        ws.Columns(16).NumberFormat = "0.0;[Red]-0.0"            'negative slack in red
        For Each k In Array(10, 11, 12, 13, 14, 15, 18): ws.Columns(k).NumberFormat = "dd-mmm-yyyy": Next k
    End If

    ws.Range("A1").Resize(1, nc).Value = hdr
    StyleHeader ws.Range("A1").Resize(1, nc)

    If n > 0 Then
        ReDim a(1 To n, 1 To nc)
        For Each r In c
            i = i + 1
            For j = 1 To nc
                a(i, j) = r(j)
            Next j
        Next r
        ws.Range("A2").Resize(n, nc).Value = a
        MakeTable ws, ws.Range("A1").Resize(n + 1, nc)
    Else
        ws.Range("A2").Value = "No findings"
        ws.Range("A2").Font.Italic = True
        ws.Range("A2").Font.Color = RGB(0, 97, 0)
    End If
    FinishSheet wb, ws, nc
End Sub

Private Sub PutRow(s() As Variant, ByVal i As Long, ByVal nm As String, ByVal cnt As Variant, _
                   ByVal pop As Variant, ByVal res As Variant, ByVal thr As String, _
                   ByVal stat As String, ByVal note As String)
    s(i, 1) = i: s(i, 2) = nm: s(i, 3) = cnt: s(i, 4) = pop
    s(i, 5) = res: s(i, 6) = thr: s(i, 7) = stat: s(i, 8) = note
End Sub

Private Function Ratio(ByVal n As Double, ByVal d As Double) As Variant
    If d = 0 Then Ratio = "N/A" Else Ratio = n / d
End Function

Private Function PF(ByVal n As Double, ByVal d As Double, ByVal limit As Double, _
                    ByVal limitIsMax As Boolean) As String
    If d = 0 Then
        PF = "N/A"
    ElseIf limitIsMax Then
        If n / d <= limit Then PF = "PASS" Else PF = "FAIL"
    Else
        If n / d >= limit Then PF = "PASS" Else PF = "FAIL"
    End If
End Function

Private Function WorkDays(ByVal d1 As Date, ByVal d2 As Date, ByVal mpd As Double) As Double
    If d2 >= d1 Then
        WorkDays = Application.DateDifference(d1, d2) / mpd
    Else
        WorkDays = -Application.DateDifference(d2, d1) / mpd
    End If
End Function

Private Function DayOf(ByVal v As Variant) As Long
    DayOf = CLng(Int(CDbl(CDate(v))))
End Function

Private Function BaseName(ByVal s As String) As String
    Dim k As Long
    k = InStrRev(s, "\")
    If k > 0 Then s = Mid$(s, k + 1)
    If LCase$(Right$(s, 4)) = ".mpp" Then s = Left$(s, Len(s) - 4)
    BaseName = s
End Function

Private Function NzNum(ByVal v As Variant) As Double
    If IsNumeric(v) Then NzNum = CDbl(v)
End Function

Private Function DateOrEmpty(ByVal v As Variant) As Variant
    If IsDate(v) Then DateOrEmpty = CDate(v)
End Function

Private Function ConstraintName(ByVal c As Long) As String
    Select Case c
        Case pjASAP: ConstraintName = "ASAP"
        Case pjALAP: ConstraintName = "ALAP"
        Case pjMSO:  ConstraintName = "Must Start On"
        Case pjMFO:  ConstraintName = "Must Finish On"
        Case pjSNET: ConstraintName = "Start No Earlier Than"
        Case pjSNLT: ConstraintName = "Start No Later Than"
        Case pjFNET: ConstraintName = "Finish No Earlier Than"
        Case pjFNLT: ConstraintName = "Finish No Later Than"
    End Select
End Function
