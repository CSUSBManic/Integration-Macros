'Every routine in this section uses On Error Resume Next on purpose:
'a formatting step that fails must never stop the results being delivered.

Private Sub StyleHeader(rng As Object)
    On Error Resume Next
    With rng
        .Font.Bold = True
        .Font.Color = RGB(255, 255, 255)
        .Interior.Color = CLR_HEAD
        .VerticalAlignment = -4108            'xlCenter
    End With
End Sub

'Freezes the first nRow rows / nCol columns (0, 0 = no freeze) and hides gridlines
Private Sub FreezeAt(wb As Object, ws As Object, ByVal nRow As Long, ByVal nCol As Long)
    On Error Resume Next
    ws.Activate
    With wb.Windows(1)
        .FreezePanes = False
        .DisplayGridlines = False
        If nRow > 0 Or nCol > 0 Then
            .ScrollRow = 1
            .ScrollColumn = 1
            .SplitRow = nRow
            .SplitColumn = nCol
            .FreezePanes = True
        End If
    End With
End Sub

'Styles one 8-column results table on the Summary: header at row r0, n data rows below it
Private Sub StyleTable(ws As Object, ByVal r0 As Long, ByVal n As Long, s() As Variant)
    Dim i As Long, r As Long
    On Error Resume Next

    StyleHeader ws.Cells(r0, 1).Resize(1, 8)
    ws.Cells(r0, 1).Resize(1, 8).HorizontalAlignment = -4108
    ws.Rows(r0).RowHeight = 22
    With ws.Cells(r0, 1).Resize(n + 1, 8).Borders
        .LineStyle = 1                        'xlContinuous
        .Weight = 2                           'xlThin
        .Color = RGB(191, 191, 191)
    End With
    ws.Cells(r0 + 1, 3).Resize(n, 2).NumberFormat = "#,##0"
    ws.Cells(r0 + 1, 5).Resize(n, 1).NumberFormat = "0.00%"
    ws.Cells(r0 + 1, 1).Resize(n, 8).VerticalAlignment = -4108
    ws.Cells(r0 + 1, 1).Resize(n, 1).HorizontalAlignment = -4108
    ws.Cells(r0 + 1, 3).Resize(n, 5).HorizontalAlignment = -4108
    ws.Cells(r0 + 1, 8).Resize(n, 1).WrapText = True

    For i = 1 To n
        r = r0 + i
        If i Mod 2 = 0 Then ws.Cells(r, 1).Resize(1, 8).Interior.Color = RGB(242, 242, 242)
        With ws.Cells(r, 7)
            .Font.Bold = True
            Select Case s(i, 7)
                Case "PASS", "CLEAR": .Interior.Color = RGB(198, 239, 206): .Font.Color = RGB(0, 97, 0)
                Case "FAIL":          .Interior.Color = RGB(255, 199, 206): .Font.Color = RGB(156, 0, 6)
                Case Else:            .Interior.Color = RGB(255, 235, 156): .Font.Color = RGB(156, 87, 0)
            End Select
        End With
    Next i

    ws.Rows((r0 + 1) & ":" & (r0 + n)).AutoFit
    For i = 1 To n
        If ws.Rows(r0 + i).RowHeight < 20 Then ws.Rows(r0 + i).RowHeight = 20
    Next i
End Sub

Private Sub FormatSummary(wb As Object, ws As Object, s() As Variant, ax() As Variant, _
                          ByVal hasWarn As Boolean)
    On Error Resume Next

    'title bar
    With ws.Range("A1:H1")
        .Interior.Color = CLR_HEAD
        .Font.Color = RGB(255, 255, 255)
        .Font.Bold = True
        .Font.Size = 16
        .VerticalAlignment = -4108
    End With
    ws.Rows(1).RowHeight = 30

    'information block
    With ws.Range("A2:A7")
        .Font.Bold = True
        .Font.Color = CLR_HEAD
    End With
    ws.Range("B6").Font.Bold = True
    If hasWarn Then
        ws.Range("B7").Font.Bold = True
        ws.Range("B7").Font.Color = RGB(192, 0, 0)
    End If

    'column widths (fixed, so the long text in B2:B7 does not stretch column B)
    ws.Columns(1).ColumnWidth = 13
    ws.Columns(2).ColumnWidth = 28
    ws.Columns(3).ColumnWidth = 11
    ws.Columns(4).ColumnWidth = 12
    ws.Columns(5).ColumnWidth = 11
    ws.Columns(6).ColumnWidth = 18
    ws.Columns(7).ColumnWidth = 11
    ws.Columns(8).ColumnWidth = 85

    'DCMA table (rows 13 and 14 are indexes, not percentages)
    StyleTable ws, SUM_HDR_ROW, 14, s
    ws.Cells(SUM_HDR_ROW + 13, 5).Resize(2, 1).NumberFormat = "0.00"

    'additional audits table
    With ws.Cells(ADD_HDR_ROW - 1, 1)
        .Font.Bold = True
        .Font.Size = 12
        .Font.Color = CLR_HEAD
    End With
    StyleTable ws, ADD_HDR_ROW, 4, ax

    'footnote
    With ws.Cells(ADD_HDR_ROW + 6, 1)
        .Font.Italic = True
        .Font.Color = RGB(89, 89, 89)
    End With

    FreezeAt wb, ws, 0, 0                     'gridlines off, no freeze
End Sub

Private Sub FormatRecon(wb As Object, ws As Object, recon() As Variant, _
                        ByVal nFiles As Long, ByVal sdText As String)
    Dim i As Long, j As Long
    On Error Resume Next

    StyleHeader ws.Range("A1").Resize(1, QC)
    ws.Range("A1").Resize(1, QC).WrapText = True
    ws.Range("B1").Resize(1, QC - 1).HorizontalAlignment = -4108
    ws.Rows(1).RowHeight = 34

    ws.Range("C2").Resize(nFiles + 1, QC - 2).NumberFormat = "#,##0"
    ws.Range("B2").Resize(nFiles + 1, 1).HorizontalAlignment = -4108
    With ws.Range("A1").Resize(nFiles + 2, QC).Borders
        .LineStyle = 1
        .Weight = 2
        .Color = RGB(191, 191, 191)
    End With

    For i = 1 To nFiles
        If i Mod 2 = 0 Then ws.Cells(i + 1, 1).Resize(1, QC).Interior.Color = RGB(242, 242, 242)
        'amber = this file's status date differs from the one used (or is missing)
        If CStr(recon(i, 2)) <> sdText Then ws.Cells(i + 1, 2).Interior.Color = RGB(255, 235, 156)
    Next i

    With ws.Cells(nFiles + 2, 1).Resize(1, QC)       'total row
        .Font.Bold = True
