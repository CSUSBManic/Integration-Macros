'Turns a findings range into an Excel table (banding + filter buttons).
'Falls back to a plain AutoFilter if the table cannot be created.
Private Sub MakeTable(ws As Object, rng As Object)
    Dim lo As Object
    On Error Resume Next
    Set lo = ws.ListObjects.Add(1, rng, , 1)  'xlSrcRange, xlYes (has headers)
    If lo Is Nothing Then
        rng.AutoFilter
    Else
        lo.TableStyle = TABLE_STYLE
    End If
End Sub

'Column widths, header height, frozen header row + PUID column, gridlines off
Private Sub FinishSheet(wb As Object, ws As Object, ByVal nc As Long)
    Dim j As Long, w As Double
    On Error Resume Next
    ws.UsedRange.Columns.AutoFit
    For j = 1 To nc
        w = ws.Columns(j).ColumnWidth + 3     'room for the filter button
        If w > 60 Then w = 60
        If w < 10 Then w = 10
        ws.Columns(j).ColumnWidth = w
    Next j
    ws.Rows(1).RowHeight = 22
    FreezeAt wb, ws, 1, 1
End Sub

'Hyperlinks from the names in one Summary table to their findings sheets, and tab colours.
'hdrRow = header row of the table; first = index in shNames of its first sheet; n = number of rows to link
Private Sub LinkSheets(wb As Object, ws As Object, s() As Variant, ByVal hdrRow As Long, _
                       shNames As Variant, ByVal first As Long, ByVal n As Long)
    Dim i As Long, sh As Object, nm As String
    On Error Resume Next
    For i = 1 To n
        nm = shNames(first + i - 1)
        Set sh = Nothing
        Set sh = wb.Worksheets(nm)
        If Not sh Is Nothing Then
            ws.Hyperlinks.Add ws.Cells(hdrRow + i, 2), "", "'" & nm & "'!A1", "Open the " & nm & " sheet"
            Select Case s(i, 7)
                Case "PASS", "CLEAR": sh.Tab.Color = RGB(0, 176, 80)
                Case "FAIL":          sh.Tab.Color = RGB(192, 0, 0)
                Case "REVIEW":        sh.Tab.Color = RGB(255, 192, 0)
                Case Else:            sh.Tab.Color = RGB(166, 166, 166)
            End Select
        End If
    Next i
    ws.Tab.Color = CLR_HEAD
End Sub

