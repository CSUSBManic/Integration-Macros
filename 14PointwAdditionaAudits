Option Explicit

'==================== SETTINGS ====================
Private Const HIGH_FLOAT_DAYS As Double = 44        'Metric 6 limit (working days)
Private Const HIGH_DUR_DAYS As Double = 44          'Metric 8 limit (working days)
Private Const EXCLUDE_MILESTONES As Boolean = False 'True = strict DCMA (drop zero-duration tasks)
Private Const LOE_FIELD As String = ""              'e.g. "Flag5" or "Text10"; "" = no LOE exclusion
Private Const LOE_VALUE As String = "Yes"           'value in LOE_FIELD that marks a task as LOE
Private Const LIST_NON_FS As Boolean = True         'list every non-FS link on sheet 04
Private Const STATUS_DATE_OVERRIDE As String = ""   'e.g. "2026-10-30"; "" = automatic
Private Const OOS_INCLUDE_HISTORIC As Boolean = False   'True = also list out-of-sequence cases where the predecessor has since caught up
Private Const TABLE_STYLE As String = "TableStyleMedium2"   'Excel table style for findings sheets
Private Const CLR_HEAD As Long = 6567967            'header colour = RGB(31, 56, 100) navy
'==================================================

Private Const TC As Long = 18   'columns on task sheets
Private Const RC As Long = 12   'columns on relationship sheets
Private Const QC As Long = 12   'columns on reconciliation sheet
Private Const SUM_HDR_ROW As Long = 9                   'header row of the DCMA table on Summary
Private Const ADD_HDR_ROW As Long = SUM_HDR_ROW + 17    'header row of the additional-audits table

'run state
Private sdDay As Long, loeFld As Long, maxBF As Date, curFile As String
Private nSdDiff As Long, nPuidErr As Long
Private curT As Task            'task being read (for error reporting)
Private dFiles As Object        'file path / name -> Project object

'counters
Private nTotal As Long, nInc As Long, nIncDur As Long, nRel As Long, nFS As Long
Private nLogic As Long, nLead As Long, nLag As Long, nHard As Long
Private nHiFloat As Long, nNegFloat As Long, nHiDur As Long
Private nInvalid As Long, nNoRes As Long
Private nMissed As Long, nBLDue As Long, nDone As Long

'additional-audit counters
Private nOos As Long, nOosLinks As Long, nOosSkip As Long, nStarted As Long
Private nDangS As Long, nDangF As Long, nNotStDur As Long
Private nSnet As Long, nSnetOld As Long

'detail collectors
Private cLogic As Collection, cLead As Collection, cLag As Collection
Private cNonFS As Collection, cHard As Collection, cHiFloat As Collection
Private cNegFloat As Collection, cHiDur As Collection, cInvalid As Collection
Private cNoRes As Collection, cMissed As Collection
Private cOos As Collection, cDangS As Collection, cDangF As Collection, cSnet As Collection

Public Sub DCMA14_Check()

    Dim prj As Project, p As Project
    Dim files As New Collection, unread As New Collection
    Dim sd As Date, sdSource As String, v As Variant, k As Variant
    Dim recon() As Variant, tot() As Variant
    Dim i As Long, j As Long, tStart As Single, errMsg As String, warn As String
    Dim nPass As Long, nFail As Long, oosNote As String
    Dim xl As Object, wb As Object, ws As Object, wsR As Object
    Dim hT As Variant, hR As Variant, hQ As Variant, shNames As Variant

    On Error GoTo Fail
    tStart = Timer
    Set prj = ActiveProject
    ResetState
    If Len(LOE_FIELD) > 0 Then loeFld = FieldNameToFieldConstant(LOE_FIELD, pjTask)

    Application.ScreenUpdating = False

    'Expand the master so every subproject is loaded
    If prj.Subprojects.Count > 0 Then
        On Error Resume Next
        SelectAll
        OutlineShowAllTasks
        On Error GoTo Fail
    End If

    'Build the list of files: master first, then every subproject (nested ones included)
    files.Add prj
    RegisterFile prj
    CollectSubprojects prj, files, unread

    '---------------- status date ----------------
    If Len(STATUS_DATE_OVERRIDE) > 0 Then
        sd = CDate(STATUS_DATE_OVERRIDE)
        sdSource = "STATUS_DATE_OVERRIDE setting"
    ElseIf IsDate(prj.StatusDate) Then
        sd = CDate(prj.StatusDate)
        sdSource = "master project"
    Else
        For Each p In files
            If IsDate(p.StatusDate) Then
                If CDate(p.StatusDate) > sd Then sd = CDate(p.StatusDate)
            End If
        Next p
        If sd > 0 Then
            sdSource = "latest subproject status date - master has none"
        Else
            Application.ScreenUpdating = True
            v = InputBox("No status date is set in the master or in any subproject." & vbCrLf & _
                         "Enter the status date to assess against:", "DCMA 14-Point", Format(Date, "yyyy-mm-dd"))
            If Not IsDate(v) Then
                MsgBox "No valid status date - check cancelled.", vbExclamation
                Exit Sub
            End If
            sd = CDate(v)
            sdSource = "entered at run time"
            Application.ScreenUpdating = False
        End If
    End If
    sdDay = DayOf(sd)

    '---------------- scan every file once ----------------
    ReDim recon(1 To files.Count, 1 To QC)
    i = 0
    For Each p In files
        i = i + 1
        ScanProject p, (i = 1), (prj.Subprojects.Count > 0), recon, i
    Next p

    '--- 13 CPLI = (critical path length + total float) / critical path length
    Dim vPF As Variant, vPBF As Variant, cpl As Double, tf As Double, mpd As Double
    Dim cpli As Variant, cpliStat As String, cpliNote As String
    mpd = prj.HoursPerDay * 60
    If mpd <= 0 Then mpd = 480
    cpli = "N/A": cpliStat = "N/A"
    vPF = prj.ProjectSummaryTask.Finish
    vPBF = prj.ProjectSummaryTask.BaselineFinish
    If Not IsDate(vPBF) Then If maxBF > 0 Then vPBF = maxBF   'master not baselined: use latest task baseline
    If IsDate(vPF) And IsDate(vPBF) Then
        cpl = WorkDays(sd, CDate(vPF), mpd)
        tf = WorkDays(CDate(vPF), CDate(vPBF), mpd)
        If cpl > 0 Then
            cpli = (cpl + tf) / cpl
            If cpli >= 0.95 Then cpliStat = "PASS" Else cpliStat = "FAIL"
        End If
        cpliNote = "CPL = " & Format(cpl, "0.0") & " wd (status date to forecast finish); float vs baseline finish = " & Format(tf, "0.0") & " wd"
    Else
        cpliNote = "No baseline finish found - cannot calculate"
    End If

    '========================= EXCEL OUTPUT =========================
    Set xl = CreateObject("Excel.Application")
    xl.ScreenUpdating = False
    Set wb = xl.Workbooks.Add(-4167)          'xlWBATWorksheet: one sheet
    Set ws = wb.Worksheets(1)
    ws.Name = "Summary"

    If unread.Count > 0 Then warn = unread.Count & " subproject(s) could NOT be read - see 00 Reconciliation.  "
    If nSdDiff > 0 Then warn = warn & nSdDiff & " file(s) have a status date different from the one used - see 00 Reconciliation.  "
    If nPuidErr > 0 Then warn = warn & nPuidErr & " PUID (Text15) value(s) could not be read and are shown as #ERROR on the detail sheets."
    If Len(warn) = 0 Then warn = "None"

    'DCMA 14-point table
    Dim s(1 To 14, 1 To 8) As Variant
    PutRow s, 1, "Logic", nLogic, nInc, Ratio(nLogic, nInc), "<= 5%", PF(nLogic, nInc, 0.05, True), "Incomplete tasks missing a predecessor and/or successor"
    PutRow s, 2, "Leads", nLead, nRel, Ratio(nLead, nRel), "0%", PF(nLead, nRel, 0, True), "Predecessor links with negative lag"
    PutRow s, 3, "Lags", nLag, nRel, Ratio(nLag, nRel), "<= 5%", PF(nLag, nRel, 0.05, True), "Predecessor links with positive lag"
    PutRow s, 4, "Relationship Types", nFS, nRel, Ratio(nFS, nRel), ">= 90%", PF(nFS, nRel, 0.9, False), "Finish-to-Start links as a share of all links"
    PutRow s, 5, "Hard Constraints", nHard, nInc, Ratio(nHard, nInc), "<= 5%", PF(nHard, nInc, 0.05, True), "MSO, MFO, SNLT, FNLT on incomplete tasks"
    PutRow s, 6, "High Float", nHiFloat, nInc, Ratio(nHiFloat, nInc), "<= 5%", PF(nHiFloat, nInc, 0.05, True), "Total slack > " & HIGH_FLOAT_DAYS & " working days"
    PutRow s, 7, "Negative Float", nNegFloat, nInc, Ratio(nNegFloat, nInc), "0%", PF(nNegFloat, nInc, 0, True), "Total slack < 0"
    PutRow s, 8, "High Duration", nHiDur, nInc, Ratio(nHiDur, nInc), "<= 5%", PF(nHiDur, nInc, 0.05, True), "Baseline duration > " & HIGH_DUR_DAYS & " working days"
    PutRow s, 9, "Invalid Dates", nInvalid, nTotal, Ratio(nInvalid, nTotal), "0%", PF(nInvalid, nTotal, 0, True), "Forecast dates before, or actual dates after, the status date (by calendar day)"
    PutRow s, 10, "Resources", nNoRes, nIncDur, Ratio(nNoRes, nIncDur), "0%", PF(nNoRes, nIncDur, 0, True), "Incomplete tasks with duration and no resources"
    PutRow s, 11, "Missed Tasks", nMissed, nBLDue, Ratio(nMissed, nBLDue), "<= 5%", PF(nMissed, nBLDue, 0.05, True), "Baseline finish <= status date, finished late or not finished"
    PutRow s, 12, "Critical Path Test", "", "", "Manual", "Finish slips ~1:1", "MANUAL", "Add 600d to a critical task on a COPY and confirm the project finish moves by about the same amount"
    PutRow s, 13, "Critical Path Length Index", "", "", cpli, ">= 0.95", cpliStat, cpliNote
    PutRow s, 14, "Baseline Execution Index", nDone, nBLDue, Ratio(nDone, nBLDue), ">= 0.95", PF(nDone, nBLDue, 0.95, False), "Tasks finished / tasks baselined to finish by status date"

    For i = 1 To 14
        If s(i, 7) = "PASS" Then nPass = nPass + 1
        If s(i, 7) = "FAIL" Then nFail = nFail + 1
    Next i

    'additional audits table (not part of the DCMA score)
    oosNote = "Tasks with actuals whose predecessor link is not satisfied (FS/FF: predecessor not finished; SS/SF: predecessor not started). " & _
              Format(nOosLinks, "#,##0") & " link(s) listed; " & Format(nOosSkip, "#,##0") & _
              " cross-project link(s) could not be checked; links with leads are skipped"
    If OOS_INCLUDE_HISTORIC Then oosNote = oosNote & "; historic cases included"

    Dim ax(1 To 4, 1 To 8) As Variant
    PutRow ax, 1, "Out of Sequence Logic", nOos, nStarted, Ratio(nOos, nStarted), "Review if > 0", Flag(nOos, nStarted), oosNote
    PutRow ax, 2, "Dangling Starts", nDangS, nNotStDur, Ratio(nDangS, nNotStDur), "Review if > 0", Flag(nDangS, nNotStDur), _
           "Not-started tasks with duration that have predecessors, but none is FS or SS (tasks with no predecessor at all are on 01 Logic)"
    PutRow ax, 3, "Dangling Finishes", nDangF, nIncDur, Ratio(nDangF, nIncDur), "Review if > 0", Flag(nDangF, nIncDur), _
           "Incomplete tasks with duration that have successors, but none is FS or FF (tasks with no successor at all are on 01 Logic)"
    PutRow ax, 4, "SNET Not Needed", nSnetOld, nSnet, Ratio(nSnetOld, nSnet), "Review if > 0", Flag(nSnetOld, nSnet), _
           "SNET constraints on incomplete tasks where the task has started, the SNET date is on/before the status date, or predecessors already hold the start later"
    For i = 1 To 4
        ax(i, 1) = "A" & i
    Next i

    Dim hdr(1 To 7, 1 To 2) As Variant
    hdr(1, 1) = "DCMA 14-Point Assessment"
    hdr(2, 1) = "Project":     hdr(2, 2) = prj.Name
    hdr(3, 1) = "Status date": hdr(3, 2) = Format(sd, "dd-mmm-yyyy") & "  (source: " & sdSource & ")"
    hdr(4, 1) = "Population":  hdr(4, 2) = Format(nTotal, "#,##0") & " tasks assessed across " & files.Count & " files; " & _
                                           Format(nInc, "#,##0") & " incomplete; " & Format(nRel, "#,##0") & _
                                           " predecessor links on incomplete tasks; milestones " & _
                                           IIf(EXCLUDE_MILESTONES, "excluded", "included")
    hdr(5, 1) = "Run"
    hdr(6, 1) = "Result":      hdr(6, 2) = nPass & " passed, " & nFail & " failed, " & (14 - nPass - nFail) & " manual or not applicable"
    hdr(7, 1) = "Warnings":    hdr(7, 2) = warn
    ws.Range("A1").Resize(7, 2).Value = hdr

    ws.Cells(SUM_HDR_ROW, 1).Resize(1, 8).Value = Array("#", "Metric", "Count", "Population", "Result", "Threshold", "Status", "Basis")
    ws.Cells(SUM_HDR_ROW + 1, 1).Resize(14, 8).Value = s
    ws.Cells(ADD_HDR_ROW - 1, 1).Value = "Additional audits (not part of the DCMA 14-point score)"
    ws.Cells(ADD_HDR_ROW, 1).Resize(1, 8).Value = Array("#", "Audit", "Count", "Population", "Result", "Threshold", "Status", "Basis")
    ws.Cells(ADD_HDR_ROW + 1, 1).Resize(4, 8).Value = ax
    ws.Cells(ADD_HDR_ROW + 6, 1).Value = "Click a metric or audit name to open its findings sheet.  Tab colours: green = pass / clear, red = fail, amber = review, grey = not applicable."
    FormatSummary wb, ws, s, ax, (warn <> "None")

    'reconciliation sheet: where every row in every file went
    Set wsR = wb.Worksheets.Add(, ws)
    wsR.Name = "00 Reconciliation"
    hQ = Array("File", "File Status Date", "Rows Read", "Blank Rows", "Summary Rows", "External (Ghost) Tasks", _
               "Inactive", "Milestones (0 Duration)", "LOE", "Assessed (Total Tasks)", "Complete", "Incomplete")
    wsR.Columns(1).NumberFormat = "@"
    wsR.Range("A1").Resize(1, QC).Value = hQ
    wsR.Range("A2").Resize(files.Count, QC).Value = recon
    ReDim tot(1 To 1, 1 To QC)
    tot(1, 1) = "TOTAL"
    For j = 3 To QC
        For i = 1 To files.Count
            tot(1, j) = tot(1, j) + recon(i, j)
        Next i
    Next j
    wsR.Range("A" & files.Count + 2).Resize(1, QC).Value = tot
    If unread.Count > 0 Then
        i = files.Count + 4
        wsR.Range("A" & i).Value = "Subprojects that could NOT be read:"
        wsR.Range("A" & i).Font.Bold = True
        For Each k In unread
            i = i + 1
            wsR.Range("A" & i).Value = k
        Next k
    End If
    FormatRecon wb, wsR, recon, files.Count, Format(sd, "dd-mmm-yyyy")

    'detail sheets
    hT = Array("PUID (Text15)", "Subproject", "Unique ID", "ID", "Task Name", "Finding", "% Complete", _
               "Duration (d)", "Baseline Duration (d)", "Start", "Finish", "Baseline Start", "Baseline Finish", _
               "Actual Start", "Actual Finish", "Total Slack (d)", "Constraint Type", "Constraint Date")
    hR = Array("Successor PUID (Text15)", "Successor Subproject", "Successor Unique ID", "Successor Name", _
               "Predecessor PUID (Text15)", "Predecessor Subproject", "Predecessor Unique ID", "Predecessor Name", _
               "Link Type", "Lag", "Lag Basis", "Finding")
    shNames = Array("01 Logic", "02 Leads", "03 Lags", "04 Non-FS Links", "05 Hard Constraints", "06 High Float", _
                    "07 Negative Float", "08 High Duration", "09 Invalid Dates", "10 Resources", "11 Missed Tasks", _
                    "A1 Out of Sequence", "A2 Dangling Starts", "A3 Dangling Finishes", "A4 SNET Not Needed")

    DumpSheet wb, shNames(0), hT, cLogic, False
    DumpSheet wb, shNames(1), hR, cLead, True
    DumpSheet wb, shNames(2), hR, cLag, True
    DumpSheet wb, shNames(3), hR, cNonFS, True
    DumpSheet wb, shNames(4), hT, cHard, False
    DumpSheet wb, shNames(5), hT, cHiFloat, False
    DumpSheet wb, shNames(6), hT, cNegFloat, False
    DumpSheet wb, shNames(7), hT, cHiDur, False
    DumpSheet wb, shNames(8), hT, cInvalid, False
    DumpSheet wb, shNames(9), hT, cNoRes, False
    DumpSheet wb, shNames(10), hT, cMissed, False
    DumpSheet wb, shNames(11), hR, cOos, True
    DumpSheet wb, shNames(12), hT, cDangS, False
    DumpSheet wb, shNames(13), hT, cDangF, False
    DumpSheet wb, shNames(14), hT, cSnet, False

    LinkSheets wb, ws, s, SUM_HDR_ROW, shNames, 0, 11
    LinkSheets wb, ws, ax, ADD_HDR_ROW, shNames, 11, 4

    ws.Range("B5").Value = Format(Now, "dd-mmm-yyyy hh:nn") & "  (" & Format(Timer - tStart, "0.0") & " s)"
    ws.Activate
    xl.ScreenUpdating = True
    xl.Visible = True
    Application.ScreenUpdating = True
    Set dFiles = Nothing
    Set curT = Nothing
    Exit Sub

Fail:
    errMsg = "DCMA check stopped: " & Err.Description
    If Len(curFile) > 0 Then errMsg = errMsg & vbCrLf & "While reading: " & curFile
    errMsg = errMsg & TaskLabel(curT)
    On Error Resume Next
    Application.ScreenUpdating = True
    If Not xl Is Nothing Then
        xl.ScreenUpdating = True
        xl.Visible = True
    End If
    MsgBox errMsg, vbExclamation
End Sub

'------------------------- file discovery -------------------------

Private Sub CollectSubprojects(parent As Project, files As Collection, unread As Collection)
    Dim s As Subproject, sp As Project, pth As String
    For Each s In parent.Subprojects
        Set sp = Nothing
        pth = ""
        On Error Resume Next
        pth = s.Path
        Set sp = s.SourceProject
        On Error GoTo 0
        If sp Is Nothing Then
            unread.Add IIf(Len(pth) > 0, pth, "(unknown subproject in " & parent.Name & ")")
        ElseIf Not dFiles.Exists(sp.FullName) Then
            RegisterFile sp
            files.Add sp
            CollectSubprojects sp, files, unread      'nested subprojects
        End If
    Next s
End Sub

Private Sub RegisterFile(p As Project)
    Dim nm As String
    Set dFiles(p.FullName) = p
    nm = p.Name
    If Not dFiles.Exists(nm) Then Set dFiles(nm) = p
    nm = BaseName(nm)
    If Not dFiles.Exists(nm) Then Set dFiles(nm) = p
End Sub

'------------------------- the single pass over one file -------------------------

Private Sub ScanProject(p As Project, ByVal isMaster As Boolean, ByVal hasSubs As Boolean, _
                        recon() As Variant, ByVal ri As Long)

    Dim t As Task, dep As TaskDependency, o As Task, cal As Object
    Dim mpd As Double, hiFloat As Double, hiDur As Double
    Dim sName As String, sBase As String
    Dim row As Variant, built As Boolean, bad As Boolean
    Dim vAS As Variant, vAF As Variant, vBF As Variant, vD As Variant, vS As Variant
    Dim hasAS As Boolean, hasAF As Boolean, hasBF As Boolean, isPred As Boolean, tOos As Boolean
    Dim dur As Double, ts As Double, bd As Double, lg As Double
    Dim uid As Long, nP As Long, nS As Long, nPStart As Long, nSFinish As Long
    Dim lt As Long, ct As Long, oosTxt As String, snetTxt As String
    Dim qRows As Long, qBlank As Long, qSumm As Long, qExt As Long, qInact As Long
    Dim qMile As Long, qLoe As Long, qAss As Long, qComp As Long, qInc As Long

    sName = p.Name
    sBase = BaseName(sName)
    curFile = sName
    mpd = p.HoursPerDay * 60                 'each file's own hours-per-day
    If mpd <= 0 Then mpd = 480
    hiFloat = HIGH_FLOAT_DAYS * mpd
    hiDur = HIGH_DUR_DAYS * mpd
    Set cal = FileCalendar(p)                'this file's project calendar (used by the SNET audit)

    For Each t In p.Tasks
        Set curT = t
        If t Is Nothing Then
            qRows = qRows + 1: qBlank = qBlank + 1
            GoTo NextTask
        End If

        'In the master, keep only rows that live in the master file itself;
        'subproject rows are read from their own files.
        If isMaster And hasSubs Then
            If StrComp(BaseName(t.Project), sBase, vbTextCompare) <> 0 Then GoTo NextTask
        End If

        qRows = qRows + 1
        If t.Summary Then
            qSumm = qSumm + 1: GoTo NextTask
        End If
        If isMaster Then
            If Len(t.Subproject) > 0 Then          'inserted-project placeholder row
                qSumm = qSumm + 1: GoTo NextTask
            End If
        End If
        If t.ExternalTask Then
            qExt = qExt + 1: GoTo NextTask
        End If
        If Not t.Active Then
            qInact = qInact + 1: GoTo NextTask
        End If

        vBF = t.BaselineFinish
        hasBF = IsDate(vBF)
        If hasBF Then If CDate(vBF) > maxBF Then maxBF = CDate(vBF)

        dur = NzNum(t.Duration)
        If EXCLUDE_MILESTONES Then
            If dur = 0 Then
                qMile = qMile + 1: GoTo NextTask
            End If
        End If
        If loeFld <> 0 Then
            If StrComp(LoeText(t), LOE_VALUE, vbTextCompare) = 0 Then
                qLoe = qLoe + 1: GoTo NextTask
            End If
        End If

        nTotal = nTotal + 1
        qAss = qAss + 1
        built = False
        bad = False

        vAS = t.ActualStart
        vAF = t.ActualFinish
        hasAS = IsDate(vAS)
        hasAF = IsDate(vAF)

        '--- 14 BEI numerator
        If hasAF Then
            qComp = qComp + 1
            If DayOf(vAF) <= sdDay Then nDone = nDone + 1
        End If

        '--- 11 Missed tasks / 14 BEI denominator
        If hasBF Then
            If DayOf(vBF) <= sdDay Then
                nBLDue = nBLDue + 1
                If Not hasAF Then
                    nMissed = nMissed + 1
                    AddTask cMissed, t, row, built, "Baseline finish on/before status date - not finished", mpd
                ElseIf DayOf(vAF) > DayOf(vBF) Then
                    nMissed = nMissed + 1
                    AddTask cMissed, t, row, built, "Finished later than baseline finish", mpd
                End If
            End If
        End If

        '--- 9 Invalid dates: actuals in the future (all tasks)
        If hasAS Then
            If DayOf(vAS) > sdDay Then
                bad = True
                AddTask cInvalid, t, row, built, "Actual start after status date", mpd
            End If
        End If
        If hasAF Then
            If DayOf(vAF) > sdDay Then
                bad = True
                AddTask cInvalid, t, row, built, "Actual finish after status date", mpd
            End If
        End If

        If Not hasAF Then
            nInc = nInc + 1
            qInc = qInc + 1
        End If
        If hasAS Then nStarted = nStarted + 1

        '=============== LINKS (one walk per task) ===============
        '1 Logic, 2 Leads, 3 Lags, 4 Relationship types  -> incomplete tasks
        'A1 Out of sequence                               -> tasks with an actual start
        'A2 / A3 Dangling starts and finishes             -> tallies used below
        uid = t.UniqueID
        nP = 0: nS = 0: nPStart = 0: nSFinish = 0: tOos = False

        For Each dep In t.TaskDependencies
            Set o = dep.To
            isPred = (o.UniqueID = uid)          'IDs are unique inside one file
            If isPred And isMaster And hasSubs Then
                isPred = (StrComp(BaseName(o.Project), sBase, vbTextCompare) = 0)
            End If
            lt = dep.Type

            If isPred Then
                lg = NzNum(dep.Lag)
                If Not hasAF Then
                    nP = nP + 1
                    nRel = nRel + 1
                    If lt = pjFinishToStart Then
                        nFS = nFS + 1
                        nPStart = nPStart + 1
                    Else
                        If lt = pjStartToStart Then nPStart = nPStart + 1
                        If LIST_NON_FS Then cNonFS.Add RelRow(t, dep, mpd, "Non-FS relationship")
                    End If
                    If lg < 0 Then
                        nLead = nLead + 1
                        cLead.Add RelRow(t, dep, mpd, "Lead (negative lag)")
                    ElseIf lg > 0 Then
                        nLag = nLag + 1
                        cLag.Add RelRow(t, dep, mpd, "Lag")
                    End If
                End If

                '--- A1 Out of sequence (a lead legitimately allows an early start, so those links are skipped)
                If hasAS Then
                    If lg >= 0 Then
                        oosTxt = OosFinding(dep, lt, vAS, vAF, hasAF)
                        If Len(oosTxt) > 0 Then
                            tOos = True
                            nOosLinks = nOosLinks + 1
                            cOos.Add RelRow(t, dep, mpd, oosTxt)
                        End If
                    End If
                End If

            ElseIf Not hasAF Then
                nS = nS + 1
                If lt = pjFinishToStart Or lt = pjFinishToFinish Then nSFinish = nSFinish + 1
            End If
        Next dep
        If tOos Then nOos = nOos + 1

        '=============== INCOMPLETE TASKS ONLY ===============
        If Not hasAF Then

            '--- 1 Logic
            If nP = 0 Or nS = 0 Then
                nLogic = nLogic + 1
                If nP = 0 And nS = 0 Then
                    AddTask cLogic, t, row, built, "No predecessor and no successor", mpd
                ElseIf nP = 0 Then
                    AddTask cLogic, t, row, built, "No predecessor", mpd
                Else
                    AddTask cLogic, t, row, built, "No successor", mpd
                End If
            End If

            '--- A2 Dangling starts / A3 Dangling finishes (tasks with duration only;
            '    a milestone's start and finish are the same point)
            If dur > 0 Then
                If Not hasAS Then
                    nNotStDur = nNotStDur + 1
                    If nP > 0 And nPStart = 0 Then
                        nDangS = nDangS + 1
                        AddTask cDangS, t, row, built, "Start not driven by logic: " & nP & " predecessor link(s), none FS or SS", mpd
                    End If
                End If
                If nS > 0 And nSFinish = 0 Then
                    nDangF = nDangF + 1
                    AddTask cDangF, t, row, built, "Finish drives nothing: " & nS & " successor link(s), none FS or FF", mpd
                End If
            End If

            '--- 5 Hard constraints / A4 SNET no longer needed
            ct = t.ConstraintType
            Select Case ct
                Case pjMSO, pjMFO, pjSNLT, pjFNLT
                    nHard = nHard + 1
                    AddTask cHard, t, row, built, "Hard constraint", mpd
                Case pjSNET
                    nSnet = nSnet + 1
                    snetTxt = ""
                    vD = t.ConstraintDate
                    If hasAS Then
                        snetTxt = "Task has started - the SNET no longer has any effect"
                    ElseIf IsDate(vD) Then
                        If DayOf(vD) <= sdDay Then
                            snetTxt = "SNET date is on or before the status date"
                        ElseIf nP > 0 Then
                            vS = t.Start
                            If IsDate(vS) Then
                                If DayOf(vS) > DayOf(vD) Then
                                    If WorkGap(cal, CDate(vD), CDate(vS)) > 0 Then
                                        snetTxt = "Not driving - predecessors hold the start later than the SNET date"
                                    End If
                                End If
                            End If
                        End If
                    End If
                    If Len(snetTxt) > 0 Then
                        nSnetOld = nSnetOld + 1
                        AddTask cSnet, t, row, built, snetTxt, mpd
                    End If
            End Select

            '--- 6 High float / 7 Negative float
            ts = NzNum(t.TotalSlack)
            If ts > hiFloat Then
                nHiFloat = nHiFloat + 1
                AddTask cHiFloat, t, row, built, "Total slack > " & HIGH_FLOAT_DAYS & " d", mpd
            ElseIf ts < 0 Then
                nNegFloat = nNegFloat + 1
                AddTask cNegFloat, t, row, built, "Negative total slack", mpd
            End If

            '--- 8 High duration (baseline duration; current duration if no baseline)
            bd = NzNum(t.BaselineDuration)
            If bd = 0 Then bd = dur
            If bd > hiDur Then
                nHiDur = nHiDur + 1
                AddTask cHiDur, t, row, built, "Duration > " & HIGH_DUR_DAYS & " d", mpd
            End If

            '--- 9 Invalid dates: forecasts in the past (calendar day)
            If Not hasAS Then
                vD = t.Start
                If IsDate(vD) Then
                    If DayOf(vD) < sdDay Then
                        bad = True
                        AddTask cInvalid, t, row, built, "Forecast start before status date", mpd
                    End If
                End If
            End If
            vD = t.Finish
            If IsDate(vD) Then
                If DayOf(vD) < sdDay Then
                    bad = True
                    AddTask cInvalid, t, row, built, "Forecast finish before status date", mpd
                End If
            End If

            '--- 10 Resources
            If dur > 0 Then
                nIncDur = nIncDur + 1
                If Len(t.ResourceNames) = 0 Then
                    nNoRes = nNoRes + 1
                    AddTask cNoRes, t, row, built, "No resources assigned", mpd
                End If
            End If
        End If

        If bad Then nInvalid = nInvalid + 1
NextTask:
    Next t
    Set curT = Nothing

    'reconciliation row for this file
    If isMaster And hasSubs Then
        recon(ri, 1) = sName & "  (master - its own rows only)"
    Else
        recon(ri, 1) = sName
    End If
    If IsDate(p.StatusDate) Then
        recon(ri, 2) = Format(CDate(p.StatusDate), "dd-mmm-yyyy")
        If DayOf(p.StatusDate) <> sdDay Then nSdDiff = nSdDiff + 1
    Else
        recon(ri, 2) = "none"
    End If
    recon(ri, 3) = qRows:  recon(ri, 4) = qBlank: recon(ri, 5) = qSumm
    recon(ri, 6) = qExt:   recon(ri, 7) = qInact: recon(ri, 8) = qMile
    recon(ri, 9) = qLoe:   recon(ri, 10) = qAss:  recon(ri, 11) = qComp
    recon(ri, 12) = qInc
    curFile = ""
End Sub

'------------------------- additional-audit helpers -------------------------

'Returns the finding text if this predecessor link has been worked out of sequence, "" if not.
'Compared by calendar day. Lag is not applied.
Private Function OosFinding(dep As TaskDependency, ByVal lt As Long, vAS As Variant, vAF As Variant, _
                            ByVal hasAF As Boolean) As String
    Dim pr As Task, pAS As Variant, pAF As Variant

    Set pr = PredTask(dep)
    If pr Is Nothing Then                    'cross-project predecessor that could not be resolved
        nOosSkip = nOosSkip + 1
        Exit Function
    End If
    If Not pr.Active Then Exit Function      'Project ignores links from inactive tasks
    pAS = pr.ActualStart
    pAF = pr.ActualFinish

    Select Case lt
        Case pjFinishToStart
            If Not IsDate(pAF) Then
                OosFinding = "FS: successor started " & DTxt(vAS) & "; predecessor not finished"
            ElseIf OOS_INCLUDE_HISTORIC Then
                If DayOf(vAS) < DayOf(pAF) Then OosFinding = "FS (historic): successor started " & DTxt(vAS) & ", before predecessor finished " & DTxt(pAF)
            End If
        Case pjStartToStart
            If Not IsDate(pAS) Then
                OosFinding = "SS: successor started " & DTxt(vAS) & "; predecessor not started"
            ElseIf OOS_INCLUDE_HISTORIC Then
                If DayOf(vAS) < DayOf(pAS) Then OosFinding = "SS (historic): successor started " & DTxt(vAS) & ", before predecessor started " & DTxt(pAS)
            End If
        Case pjFinishToFinish
            If hasAF Then
                If Not IsDate(pAF) Then
                    OosFinding = "FF: successor finished " & DTxt(vAF) & "; predecessor not finished"
                ElseIf OOS_INCLUDE_HISTORIC Then
                    If DayOf(vAF) < DayOf(pAF) Then OosFinding = "FF (historic): successor finished " & DTxt(vAF) & ", before predecessor finished " & DTxt(pAF)
                End If
            End If
        Case pjStartToFinish
            If hasAF Then
                If Not IsDate(pAS) Then
                    OosFinding = "SF: successor finished " & DTxt(vAF) & "; predecessor not started"
                ElseIf OOS_INCLUDE_HISTORIC Then
                    If DayOf(vAF) < DayOf(pAS) Then OosFinding = "SF (historic): successor finished " & DTxt(vAF) & ", before predecessor started " & DTxt(pAS)
                End If
            End If
    End Select
End Function

'The real predecessor task of a link. For a cross-project link the ghost task is swapped
'for the real one; Nothing is returned if that cannot be done.
Private Function PredTask(dep As TaskDependency) As Task
    Dim p As Task
    On Error Resume Next
    Set p = dep.From
    If p Is Nothing Then Exit Function
    If p.ExternalTask Then
        Set PredTask = RealTask(dep, p.Name)
    Else
        Set PredTask = p
    End If
End Function

Private Function FileCalendar(p As Project) As Object
    On Error Resume Next
    Set FileCalendar = p.Calendar
End Function

'Working minutes between two dates on the file's project calendar.
'Falls back to the active project's calendar, then to elapsed minutes.
Private Function WorkGap(cal As Object, ByVal d1 As Date, ByVal d2 As Date) As Double
    Dim m As Double
    On Error Resume Next
    m = -1
    If Not cal Is Nothing Then m = Application.DateDifference(d1, d2, cal)
    If Err.Number <> 0 Or m < 0 Then
        Err.Clear
        m = -1
        m = Application.DateDifference(d1, d2)
        If Err.Number <> 0 Or m < 0 Then
            Err.Clear
            m = (d2 - d1) * 1440
        End If
    End If
    WorkGap = m
End Function

Private Function DTxt(ByVal v As Variant) As String
    If IsDate(v) Then DTxt = Format(CDate(v), "dd-mmm-yyyy")
End Function

'Status for the additional audits (no DCMA threshold exists for these)
Private Function Flag(ByVal n As Long, ByVal pop As Long) As String
    If pop = 0 Then
        Flag = "N/A"
    ElseIf n = 0 Then
        Flag = "CLEAR"
    Else
        Flag = "REVIEW"
    End If
End Function

