Option Explicit

' Global variables for high-speed memory processing
Dim OutArr() As Variant
Dim OutCount As Long
Dim PrjDict As Object
Dim ScannedProjects As Object
Dim TasksScanned As Long

Sub ExportMasterOOSToExcel_30k()
    Dim xlApp As Object
    Dim xlBook As Object
    Dim xlSheet As Object
    Dim startTime As Double
    
    startTime = Timer
    OutCount = 0
    TasksScanned = 0
    ReDim OutArr(1 To 13, 1 To 5000) ' Pre-allocate for 5,000 OOS links (auto-expands)
    
    Set PrjDict = CreateObject("Scripting.Dictionary")
    PrjDict.CompareMode = 1 ' TextCompare (Case-insensitive)
    
    Set ScannedProjects = CreateObject("Scripting.Dictionary")
    ScannedProjects.CompareMode = 1
    
    ' 1. Lock down MS Project UI & Calculation for maximum speed
    Application.ScreenUpdating = False
    Application.Calculation = pjManual
    
    ' Force all collapsed subprojects to load into memory so none are skipped
    Application.StatusBar = "Expanding Master Schedule to ensure all Subprojects are loaded..."
    On Error Resume Next
    SelectAll
    OutlineShowAllTasks
    On Error GoTo 0
    
    ' 2. Index all loaded projects into a RAM Hash Table for instant cross-project lookups
    Application.StatusBar = "Indexing Subprojects in memory..."
    BuildProjectDictionary ActiveProject
    
    ' 3. Scan the Master Project and all Subprojects recursively
    ProcessProject ActiveProject
    
    ' Restore MS Project UI & Status Bar
    Application.StatusBar = False
    Application.Calculation = pjAutomatic
    Application.ScreenUpdating = True
    
    ' 4. Check results
    If OutCount = 0 Then
        MsgBox "Scan complete! Scanned " & Format(TasksScanned, "#,##0") & " active tasks in " & _
               Format(Timer - startTime, "0.0") & " seconds." & vbCrLf & vbCrLf & _
               "Great news: 0 Out-of-Sequence relationships found!", vbInformation
        Exit Sub
    End If
    
    ' 5. Initialize Excel and dump data in a single memory block
    Application.StatusBar = "Building Excel Report..."
    On Error Resume Next
    Set xlApp = CreateObject("Excel.Application")
    If Err.Number <> 0 Then
        Application.StatusBar = False
        MsgBox "Could not start Excel. Please make sure Excel is installed.", vbCritical
        Exit Sub
    End If
    On Error GoTo 0
    
    xlApp.ScreenUpdating = False
    Set xlBook = xlApp.Workbooks.Add
    Set xlSheet = xlBook.Sheets(1)
    xlSheet.Name = "Master OOS Report"
    
    Dim headers As Variant
    headers = Array("Project", "Task ID", "Unique ID", "Task Name", "Task % Comp", "Actual Start", _
                    "Pred Project", "Pred ID", "Pred UID", "Predecessor Name", "Link Type", "Pred % Comp", "OOS Reason")
    
    ' Transpose array in pure VBA (Bypasses Excel's Transpose limits/crashes)
    Dim FinalArr() As Variant
    ReDim FinalArr(1 To OutCount, 1 To 13)
    Dim r As Long, c As Long
    For r = 1 To OutCount
        For c = 1 To 13
            FinalArr(r, c) = OutArr(c, r)
        Next c
    Next r
    Erase OutArr ' Free RAM immediately
    
    With xlSheet
        .Range("A1:M1").Value = headers
        .Range("A1:M1").Font.Bold = True
        .Range("A1:M1").Interior.Color = RGB(217, 225, 242)
        
        ' Instant bulk write to Excel
        .Range("A2").Resize(OutCount, 13).Value = FinalArr
        
        ' Format columns
        .Columns("E:E").NumberFormat = "0%"
        .Columns("L:L").NumberFormat = "0%"
        .Columns("A:M").AutoFit
        .Range("A1:M1").AutoFilter
        .Application.ActiveWindow.SplitRow = 1
        .Application.ActiveWindow.FreezePanes = True
    End With
    
    Erase FinalArr
    Application.StatusBar = False
    xlApp.ScreenUpdating = True
    xlApp.Visible = True
    
    MsgBox "Scanned " & Format(TasksScanned, "#,##0") & " tasks in " & Format(Timer - startTime, "0.0") & " seconds!" & vbCrLf & _
           "Exported " & Format(OutCount, "#,##0") & " out-of-sequence links to Excel.", vbInformation
           
    Set xlSheet = Nothing
    Set xlBook = Nothing
    Set xlApp = Nothing
    Set PrjDict = Nothing
    Set ScannedProjects = Nothing
End Sub

Private Sub BuildProjectDictionary(ByVal prj As Project)
    Dim subPrj As Subproject
    Dim shortName As String
    
    If prj Is Nothing Then Exit Sub
    
    If Not PrjDict.Exists(prj.Name) Then PrjDict.Add prj.Name, prj
    If Not PrjDict.Exists(prj.FullName) Then PrjDict.Add prj.FullName, prj
    
    shortName = StripExtension(prj.Name)
    If Not PrjDict.Exists(shortName) Then PrjDict.Add shortName, prj
    
    For Each subPrj In prj.Subprojects
        On Error Resume Next
        If Not subPrj.SourceProject Is Nothing Then
            BuildProjectDictionary subPrj.SourceProject
        End If
        On Error GoTo 0
    Next subPrj
End Sub

Private Sub ProcessProject(ByVal prj As Project)
    Dim t As Task
    Dim subPrj As Subproject
    Dim prjName As String
    
    If prj Is Nothing Then Exit Sub
    If ScannedProjects.Exists(prj.FullName) Then Exit Sub
    ScannedProjects.Add prj.FullName, True
    
    prjName = prj.Name
    
    For Each t In prj.Tasks
        If Not t Is Nothing Then
            ' Ignore Summary tasks, External ghost tasks, and Inactive tasks
            If Not t.Summary And Not t.ExternalTask Then
                If t.Active Then
                    TasksScanned = TasksScanned + 1
                    
                    ' Keep Windows responsive and update Status Bar every 500 tasks
                    If TasksScanned Mod 500 = 0 Then
                        Application.StatusBar = "Scanning [" & prjName & "]... Tasks checked: " & _
                                                Format(TasksScanned, "#,##0") & " | OOS Found: " & OutCount
                        DoEvents
                    End If
                    
                    ' SPEED GATE: Only inspect tasks that have started AND have predecessors
                    If t.ActualStart <> "NA" Then
                        If Len(t.Predecessors) > 0 Then
                            CheckTaskOOS t, prjName
                        End If
                    End If
                End If
            End If
        End If
    Next t
    
    ' Recursively process all inserted subprojects
    For Each subPrj In prj.Subprojects
        On Error Resume Next
        If Not subPrj.SourceProject Is Nothing Then
            ProcessProject subPrj.SourceProject
        End If
        On Error GoTo 0
    Next subPrj
End Sub

Private Sub CheckTaskOOS(ByVal t As Task, ByVal tPrjName As String)
    Dim dep As TaskDependency
    Dim p As Task
    Dim realP As Task
    Dim isOOS As Boolean
    Dim relType As String
    Dim oosReason As String
    Dim tUID As Long
    Dim pPct As Double
    
    tUID = t.UniqueID
    
    For Each dep In t.TaskDependencies
        ' Fast integer check first, then verify not an external task collision
        If dep.To.UniqueID = tUID Then
            If Not dep.To.ExternalTask Then
                Set p = dep.From
                
                ' Resolve Cross-Project Ghost Task via O(1) Dictionary Lookup
                If p.ExternalTask Then
                    Set realP = ResolveExternalTaskFast(p)
                Else
                    Set realP = p
                End If
                
                If Not realP Is Nothing Then
                    If realP.Active Then
                        isOOS = False
                        pPct = realP.PercentComplete
                        
                        Select Case dep.Type
                            Case pjFinishToStart '0
                                If pPct < 100 Then
                                    isOOS = True
                                    relType = "FS"
                                    oosReason = "Started before Predecessor finished"
                                End If
                            Case pjStartToStart '1
                                If realP.ActualStart = "NA" Then
                                    isOOS = True
                                    relType = "SS"
                                    oosReason = "Started before Predecessor started"
                                End If
                            Case pjFinishToFinish '2
                                If t.PercentComplete = 100 And pPct < 100 Then
                                    isOOS = True
                                    relType = "FF"
                                    oosReason = "Finished before Predecessor finished"
                                End If
                            Case pjStartToFinish '3
                                If t.PercentComplete = 100 And realP.ActualStart = "NA" Then
                                    isOOS = True
                                    relType = "SF"
                                    oosReason = "Finished before Predecessor started"
                                End If
                        End Select
                        
                        If isOOS Then
                            OutCount = OutCount + 1
                            If OutCount > UBound(OutArr, 2) Then
                                ReDim Preserve OutArr(1 To 13, 1 To UBound(OutArr, 2) + 5000)
                            End If
                            
                            OutArr(1, OutCount) = t.Project
                            OutArr(2, OutCount) = t.ID
                            OutArr(3, OutCount) = tUID
                            OutArr(4, OutCount) = t.Name
                            OutArr(5, OutCount) = t.PercentComplete / 100
                            OutArr(6, OutCount) = Format(t.ActualStart, "yyyy-mm-dd")
                            OutArr(7, OutCount) = realP.Project
                            OutArr(8, OutCount) = realP.ID
                            OutArr(9, OutCount) = realP.UniqueID
                            OutArr(10, OutCount) = realP.Name
                            OutArr(11, OutCount) = relType
                            OutArr(12, OutCount) = pPct / 100
                            OutArr(13, OutCount) = oosReason
                        End If
                    End If
                End If
            End If
        End If
    Next dep
End Sub

Private Function ResolveExternalTaskFast(ByVal extTask As Task) As Task
    Dim srcPrj As Project
    Dim extPrjKey As String
    
    On Error Resume Next
    extPrjKey = extTask.Project
    
    If PrjDict.Exists(extPrjKey) Then
        Set srcPrj = PrjDict(extPrjKey)
        Set ResolveExternalTaskFast = srcPrj.Tasks.UniqueID(extTask.UniqueID)
        If Not ResolveExternalTaskFast Is Nothing Then Exit Function
    End If
    
    ' Fallback to ghost task properties if external file isn't part of the master
    Set ResolveExternalTaskFast = extTask
    On Error GoTo 0
End Function

Private Function StripExtension(ByVal fileName As String) As String
    Dim dotPos As Long
    dotPos = InStrRev(fileName, ".")
    If dotPos > 0 Then
        StripExtension = Left(fileName, dotPos - 1)
    Else
        StripExtension = fileName
    End If
End Function
