Option Explicit

Dim OutArr() As Variant
Dim OutCount As Long
Dim RealTaskByProjectAndName As Object

Sub ExportMasterOOSToExcel_FastSinglePass()
    Dim xlApp As Object
    Dim xlBook As Object
    Dim xlSheet As Object
    Dim t As Task
    Dim startTime As Double
    Dim TasksScanned As Long
    Dim totalTasks As Long
    Dim key As String
    
    startTime = Timer
    OutCount = 0
    TasksScanned = 0
    ReDim OutArr(1 To 16, 1 To 5000)
    
    Set RealTaskByProjectAndName = CreateObject("Scripting.Dictionary")
    RealTaskByProjectAndName.CompareMode = 1 ' Case-insensitive
    
    ' 1. Lock down UI for speed
    Application.ScreenUpdating = False
    Application.Calculation = pjManual
    
    Application.StatusBar = "Step 1/2: Expanding Master Schedule..."
    DoEvents
    On Error Resume Next
    OutlineShowAllTasks
    On Error GoTo 0
    
    totalTasks = ActiveProject.Tasks.Count
    
    ' 2. Fast Index of ActiveProject.Tasks ONLY (No Subproject file opening!)
    ' Takes ~2-3 seconds for 30,000 tasks because we use "Set" and stay in ActiveProject.Tasks
    For Each t In ActiveProject.Tasks
        If Not t Is Nothing Then
            TasksScanned = TasksScanned + 1
            If TasksScanned Mod 1000 = 0 Then
                Application.StatusBar = "Step 1/2: Indexing live tasks... " & Format(TasksScanned, "#,##0") & " / " & Format(totalTasks, "#,##0")
                DoEvents
            End If
            
            If Not t.Summary And Not t.ExternalTask Then
                ' Store reference to the live Master Task by Subproject Name + Task Name + Start Date
                key = StripExtension(t.Project) & "|" & t.Name
                If Not RealTaskByProjectAndName.Exists(key) Then
                    Set RealTaskByProjectAndName(key) = t
                End If
            End If
        End If
    Next t
    
    ' 3. Scan ActiveProject.Tasks for Out-of-Sequence Links
    TasksScanned = 0
    For Each t In ActiveProject.Tasks
        If Not t Is Nothing Then
            TasksScanned = TasksScanned + 1
            
            If TasksScanned Mod 500 = 0 Then
                Application.StatusBar = "Step 2/2: Scanning tasks... " & Format(TasksScanned, "#,##0") & _
                                        " / " & Format(totalTasks, "#,##0") & " | OOS Found: " & OutCount
                DoEvents
            End If
            
            If Not t.Summary And Not t.ExternalTask Then
                If t.Active Then
                    ' SPEED GATE: Only inspect tasks that have actually started AND have predecessors
                    If t.ActualStart <> "NA" Then
                        If Len(t.Predecessors) > 0 Then
                            CheckTaskOOS_SinglePass t
                        End If
                    End If
                End If
            End If
        End If
    Next t
    
    Application.StatusBar = False
    Application.Calculation = pjAutomatic
    Application.ScreenUpdating = True
    
    If OutCount = 0 Then
        MsgBox "Scan complete in " & Format(Timer - startTime, "0.0") & " seconds!" & vbCrLf & vbCrLf & _
               "0 Out-of-Sequence relationships found!", vbInformation
        Set RealTaskByProjectAndName = Nothing
        Exit Sub
    End If
    
    ' 4. Dump results to Excel
    Application.StatusBar = "Building Excel Report..."
    Set xlApp = CreateObject("Excel.Application")
    xlApp.ScreenUpdating = False
    Set xlBook = xlApp.Workbooks.Add
    Set xlSheet = xlBook.Sheets(1)
    xlSheet.Name = "Master OOS Report"
    
    Dim headers As Variant
    headers = Array("Subproject", "Task ID (Master)", "Unique ID (Master)", "Task Name", "Task % Comp", "Task Actual Start", "Task Actual Finish", _
                    "Pred Subproject", "Pred ID (Master)", "Pred UID (Master)", "Predecessor Name", "Link Type", "Pred % Comp", "Pred Actual Start", "Pred Actual Finish", "OOS Reason")
    
    Dim FinalArr() As Variant
    ReDim FinalArr(1 To OutCount, 1 To 16)
    Dim r As Long, c As Long
    For r = 1 To OutCount
        For c = 1 To 16
            FinalArr(r, c) = OutArr(c, r)
        Next c
    Next r
    Erase OutArr
    
    With xlSheet
        .Range("A1:P1").Value = headers
        .Range("A1:P1").Font.Bold = True
        .Range("A1:P1").Interior.Color = RGB(217, 225, 242)
        
        .Range("A2").Resize(OutCount, 16).Value = FinalArr
        
        .Columns("E:E").NumberFormat = "0%"
        .Columns("M:M").NumberFormat = "0%"
        .Columns("A:P").AutoFit
        .Range("A1:P1").AutoFilter
        .Application.ActiveWindow.SplitRow = 1
        .Application.ActiveWindow.FreezePanes = True
    End With
    
    Erase FinalArr
    Application.StatusBar = False
    xlApp.ScreenUpdating = True
    xlApp.Visible = True
    
    MsgBox "Complete in " & Format(Timer - startTime, "0.0") & " seconds!" & vbCrLf & _
           "Exported " & Format(OutCount, "#,##0") & " Out-of-Sequence links to Excel.", vbInformation
           
    Set RealTaskByProjectAndName = Nothing
End Sub

Private Sub CheckTaskOOS_SinglePass(ByVal t As Task)
    Dim dep As TaskDependency
    Dim rawP As Task
    Dim p As Task
    Dim isOOS As Boolean
    Dim relType As String
    Dim oosReason As String
    
    For Each dep In t.TaskDependencies
        ' Because we are inside ActiveProject.Tasks, every task has a 100% unique Master UniqueID!
        If dep.To.UniqueID = t.UniqueID Then
            Set rawP = dep.From
            
            If Not rawP Is Nothing Then
                ' If rawP is an External Ghost Task, resolve it to the live task in ActiveProject.Tasks
                If rawP.ExternalTask Then
                    Set p = ResolveGhostToMasterTask(rawP)
                Else
                    Set p = rawP
                End If
                
                If Not p Is Nothing Then
                    If p.Active And Not p.Summary Then
                        isOOS = False
                        oosReason = ""
                        
                        Select Case dep.Type
                            Case pjFinishToStart '0 (FS)
                                relType = "FS"
                                ' Only flag LIVE Out-of-Sequence: Successor has started, Predecessor is NOT 100% complete
                                If p.PercentComplete < 100 And p.ActualFinish = "NA" Then
                                    isOOS = True
                                    oosReason = "Started before Predecessor finished (" & p.PercentComplete & "% comp)"
                                End If
                                
                            Case pjStartToStart '1 (SS)
                                relType = "SS"
                                If p.ActualStart = "NA" And p.PercentComplete = 0 Then
                                    isOOS = True
                                    oosReason = "Started before Predecessor started (0% comp)"
                                End If
                                
                            Case pjFinishToFinish '2 (FF)
                                relType = "FF"
                                If (t.PercentComplete = 100 Or t.ActualFinish <> "NA") And (p.PercentComplete < 100 And p.ActualFinish = "NA") Then
                                    isOOS = True
                                    oosReason = "Finished before Predecessor finished (" & p.PercentComplete & "% comp)"
                                End If
                                
                            Case pjStartToFinish '3 (SF)
                                relType = "SF"
                                If (t.PercentComplete = 100 Or t.ActualFinish <> "NA") And (p.ActualStart = "NA" And p.PercentComplete = 0) Then
                                    isOOS = True
                                    oosReason = "Finished before Predecessor started (0% comp)"
                                End If
                        End Select
                        
                        If isOOS Then
                            OutCount = OutCount + 1
                            If OutCount > UBound(OutArr, 2) Then
                                ReDim Preserve OutArr(1 To 16, 1 To UBound(OutArr, 2) + 5000)
                            End If
                            
                            OutArr(1, OutCount) = t.Project
                            OutArr(2, OutCount) = t.ID
                            OutArr(3, OutCount) = t.UniqueID
                            OutArr(4, OutCount) = t.Name
                            OutArr(5, OutCount) = t.PercentComplete / 100
                            OutArr(6, OutCount) = FormatDateSafe(t.ActualStart)
                            OutArr(7, OutCount) = FormatDateSafe(t.ActualFinish)
                            OutArr(8, OutCount) = p.Project
                            OutArr(9, OutCount) = p.ID
                            OutArr(10, OutCount) = p.UniqueID
                            OutArr(11, OutCount) = p.Name
                            OutArr(12, OutCount) = relType
                            OutArr(13, OutCount) = p.PercentComplete / 100
                            OutArr(14, OutCount) = FormatDateSafe(p.ActualStart)
                            OutArr(15, OutCount) = FormatDateSafe(p.ActualFinish)
                            OutArr(16, OutCount) = oosReason
                        End If
                    End If
                End If
            End If
        End If
    Next dep
End Sub

Private Function ResolveGhostToMasterTask(ByVal ghost As Task) As Task
    On Error Resume Next
    ' ghost.Project has format: "C:\Path\SubprojectName.mpp\123"
    Dim rawPath As String
    Dim lastSlash As Long
    Dim filePart As String
    Dim shortPrj As String
    Dim key As String
    
    rawPath = ghost.Project
    lastSlash = InStrRev(rawPath, "\")
    If lastSlash > 0 Then
        filePart = Left(rawPath, lastSlash - 1)
        shortPrj = StripExtension(Mid(filePart, InStrRev(filePart, "\") + 1))
        key = shortPrj & "|" & ghost.Name
        If RealTaskByProjectAndName.Exists(key) Then
            Set ResolveGhostToMasterTask = RealTaskByProjectAndName(key)
            Exit Function
        End If
    End If
    
    Set ResolveGhostToMasterTask = ghost
    On Error GoTo 0
End Function

Private Function FormatDateSafe(ByVal d As Variant) As String
    If IsDate(d) Then
        FormatDateSafe = Format(d, "yyyy-mm-dd")
    Else
        FormatDateSafe = "NA"
    End If
End Function

Private Function StripExtension(ByVal fileName As String) As String
    Dim slashPos As Long
    Dim dotPos As Long
    slashPos = InStrRev(fileName, "\")
    If slashPos > 0 Then fileName = Mid(fileName, slashPos + 1)
    dotPos = InStrRev(fileName, ".")
    If dotPos > 0 Then
        StripExtension = Left(fileName, dotPos - 1)
    Else
        StripExtension = fileName
    End If
End Function
